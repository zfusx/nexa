---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  compiledContent,
  getHeadings,
  frontmatter,
  rawContent,
} from "../../docs/whitepaper/Nexa公众白皮书_v0.2.md";
import whitepaperV1Pdf from "../../output/pdf/Nexa公众白皮书_v0.1.pdf?url";
import whitepaperV2Pdf from "../../output/pdf/Nexa公众白皮书_v0.2.pdf?url";

const headings = getHeadings().filter((heading) => heading.depth === 2);
const compiled = await compiledContent();
const firstChapter = compiled.indexOf("<h2");
if (firstChapter < 0 || headings.length !== 7) {
  throw new Error("白皮书必须包含七个章节");
}
// 仅编译本项目维护的公开文稿；不接受用户 HTML，不读取内部技术资料。
const chapters = compiled.slice(firstChapter);
const coverNote = rawContent().split("## 01")[0]?.trim().split("\n\n").at(-1);
if (!coverNote) throw new Error("白皮书缺少版本与证据范围说明");
---

<BaseLayout
  title={`${frontmatter.title}｜Nexa 公众方法白皮书`}
  description={frontmatter.description}
>
  <section class="research-hero">
    <div class="container research-cover">
      <p class="eyebrow">NEXA · 方法与研究</p>
      <p class="edition">
        {frontmatter.version} / {frontmatter.status} / {frontmatter.date}
      </p>
      <h1>让复杂有章可循，<br />让理解经得起追问。</h1>
      <p class="research-lede">{frontmatter.description}</p>
      <div class="research-actions">
        <a class="button button-primary" href="#read">阅读白皮书</a>
        <a
          class="button button-light"
          href={whitepaperV2Pdf}
          download="Nexa公众白皮书_v0.2.pdf">下载 PDF · v0.2</a
        >
      </div>
      <p class="review-note">{coverNote}</p>
    </div>
  </section>
  <section class="edition-selector" aria-labelledby="edition-title">
    <div class="container">
      <p class="eyebrow">选择阅读版本</p>
      <div class="edition-heading">
        <h2 id="edition-title">同一套方法，两种阅读深度。</h2>
        <p>
          两个版本均为审阅稿；v0.2 是当前专业版，v0.1 保留为更轻量的入门参考。
        </p>
      </div>
      <div class="edition-grid">
        <article class="edition-card edition-card-current">
          <p class="edition-tag">当前版本 · 12 页</p>
          <h3>v0.2｜专业数学版</h3>
          <p>
            展开组成几何、条件系统、时间路径、概率校准、OCQM-6
            与证据治理，适合产品、技术及研究审阅。
          </p>
          <a
            class="button button-primary"
            href={whitepaperV2Pdf}
            download="Nexa公众白皮书_v0.2.pdf">下载 v0.2</a
          >
        </article>
        <article class="edition-card">
          <p class="edition-tag">入门参考 · 8 页</p>
          <h3>v0.1｜普通读者版</h3>
          <p>
            用较少公式说明研究方式、时间变化与 AI 解释，适合第一次认识 Nexa
            的读者。
          </p>
          <a
            class="button button-secondary"
            href={whitepaperV1Pdf}
            download="Nexa公众白皮书_v0.1.pdf">下载 v0.1</a
          >
        </article>
      </div>
    </div>
  </section>
  <div class="container reading-layout" id="read">
    <aside class="contents">
      <nav aria-label="白皮书章节目录">
        <p class="contents-label">阅读目录</p>
        <ol>
          {
            headings.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))
          }
        </ol>
        <p class="contents-note">从方法出发，<br />回到你的真实问题。</p>
      </nav>
    </aside>
    <article
      class="paper-content"
      aria-label="白皮书正文"
      set:html={chapters}
    />
  </div>
  <section class="research-end">
    <div class="container">
      <p>带着一个真实问题，继续认识 Nexa。</p>
      <a class="button button-primary" href="/#experience">体验回答方式</a>
      <a class="text-link" href="/story">读我们的故事 →</a>
    </div>
  </section>
</BaseLayout>

<style>
  :global(body) {
    min-width: 0;
  }
  .research-hero {
    position: relative;
    overflow: hidden;
    padding: 145px 0 70px;
    color: var(--ink);
    background:
      linear-gradient(
        90deg,
        #110630 0%,
        rgba(17, 6, 48, 0.96) 38%,
        rgba(17, 6, 48, 0.38) 72%,
        rgba(17, 6, 48, 0.72) 100%
      ),
      linear-gradient(180deg, transparent 46%, #110630 100%),
      url("/brand/nexa-yearly-hero.webp") top right / 780px auto no-repeat,
      #110630;
  }
  .research-cover {
    position: relative;
    z-index: 1;
  }
  .research-hero .eyebrow {
    color: var(--violet-light);
  }
  .edition {
    margin: 0 0 32px;
    color: #bcb2d5;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }
  h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.35rem, 5vw, 4.3rem);
    line-height: 1.32;
    font-weight: 500;
    letter-spacing: -0.045em;
  }
  .research-lede {
    max-width: 660px;
    margin: 27px 0 0;
    color: #d3cbe4;
    font-size: 1.14rem;
    line-height: 1.9;
  }
  .research-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 32px 0;
  }
  .review-note {
    max-width: 760px;
    margin: 32px 0 0;
    padding-left: 17px;
    border-left: 2px solid var(--violet);
    color: #c5bcd7;
    font-size: 0.84rem;
    line-height: 1.85;
  }
  .edition-selector {
    padding: 72px 0 8px;
    background: var(--night);
  }
  .edition-selector .eyebrow {
    color: var(--violet);
  }
  .edition-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(300px, 0.95fr);
    align-items: end;
    gap: 56px;
    margin: 22px 0 32px;
  }
  .edition-heading h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 3vw, 2.8rem);
    line-height: 1.45;
    font-weight: 500;
  }
  .edition-heading p {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.8;
  }
  .edition-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .edition-card {
    padding: 30px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--night-raised);
  }
  .edition-card-current {
    border-color: rgba(169, 143, 232, 0.5);
    background: linear-gradient(
      104deg,
      rgba(57, 31, 128, 0.8) 2.86%,
      rgba(33, 18, 75, 0.94) 32%,
      rgba(17, 6, 48, 0.94) 88%,
      rgba(68, 38, 154, 0.8) 103%
    );
  }
  .edition-tag {
    margin: 0 0 14px;
    color: var(--violet);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
  }
  .edition-card h3 {
    margin: 0 0 10px;
    font-size: 1.28rem;
  }
  .edition-card > p:not(.edition-tag) {
    min-height: 3.7em;
    margin: 0 0 24px;
    color: var(--ink-soft);
    line-height: 1.8;
  }
  .reading-layout {
    display: grid;
    grid-template-columns: 270px minmax(0, 1fr);
    gap: 85px;
    padding-block: 80px 32px;
  }
  .contents nav {
    position: sticky;
    top: 110px;
  }
  .contents-label {
    margin: 0 0 24px;
    color: var(--violet);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }
  .contents ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .contents li {
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.85rem;
  }
  .contents a {
    display: block;
    padding-block: 5px;
  }
  .contents a:hover {
    color: var(--violet-light);
  }
  .contents-note {
    margin-top: 30px;
    color: var(--ink-soft);
    font-family: var(--font-heading);
    font-size: 1.15rem;
  }
  .paper-content {
    min-width: 0;
    max-width: 725px;
    font-size: 1.05rem;
    line-height: 1.95;
  }
  .paper-content :global(h2) {
    margin: 82px 0 27px;
    padding-top: 36px;
    border-top: 1px solid var(--line);
    font-family: var(--font-heading);
    font-size: clamp(1.7rem, 2.7vw, 2.25rem);
    line-height: 1.5;
    letter-spacing: -0.035em;
    scroll-margin-top: 105px;
  }
  .paper-content :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border: 0;
  }
  .paper-content :global(h3) {
    margin: 35px 0 12px;
    color: var(--violet-light);
    font-size: 1.12rem;
    line-height: 1.7;
    font-weight: 650;
  }
  .paper-content :global(p) {
    margin: 0 0 20px;
  }
  .paper-content :global(ul) {
    padding-left: 1.2rem;
  }
  .paper-content :global(li) {
    margin-bottom: 13px;
  }
  .paper-content :global(blockquote) {
    margin: 28px 0 0;
    padding: 24px 28px;
    border-left: 3px solid var(--violet);
    border-radius: 0 15px 15px 0;
    background: var(--night-raised);
    font-family: var(--font-heading);
    font-size: 1.17rem;
    line-height: 1.9;
  }
  .paper-content :global(blockquote p) {
    margin: 0;
  }
  .paper-content :global(pre) {
    overflow-x: auto;
    margin: 24px 0;
    padding: 20px 22px;
    border: 1px solid #37275d;
    border-radius: 14px;
    color: #f3efff;
    background: #20163c;
    font-size: 0.86rem;
    line-height: 1.75;
  }
  .paper-content :global(code) {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  }
  .research-end {
    padding-block: 48px 90px;
    text-align: center;
  }
  .research-end p {
    font-family: var(--font-heading);
    font-size: 1.5rem;
  }
  .text-link {
    display: inline-block;
    margin: 20px;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  @media (max-width: 900px) {
    .edition-heading {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .reading-layout {
      grid-template-columns: 1fr;
      gap: 44px;
      padding-top: 45px;
    }
    .contents nav {
      position: static;
    }
    .contents ol {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 24px;
    }
    .contents-note {
      display: none;
    }
    .paper-content {
      max-width: none;
    }
  }
  @media (max-width: 540px) {
    h1 {
      font-size: clamp(1.65rem, 8vw, 2.6rem);
    }
    .research-hero {
      padding: 115px 0 45px;
      background:
        linear-gradient(
          180deg,
          rgba(17, 6, 48, 0.3) 0%,
          rgba(17, 6, 48, 0.82) 42%,
          #110630 100%
        ),
        url("/brand/nexa-yearly-hero.webp") top center / auto 480px no-repeat,
        #110630;
    }
    .research-lede {
      font-size: 1rem;
    }
    .edition-selector {
      padding-top: 48px;
    }
    .edition-grid {
      grid-template-columns: 1fr;
    }
    .edition-card {
      padding: 24px;
    }
    .edition-card > p:not(.edition-tag) {
      min-height: 0;
    }
    .contents ol {
      grid-template-columns: 1fr;
    }
    .contents a {
      padding-block: 7px;
    }
    .paper-content {
      font-size: 1rem;
    }
    .paper-content :global(blockquote) {
      padding: 19px 20px;
    }
  }
</style>
